# Copie para .env e preencha os quatro valores abaixo com valores locais distintos.
# Gere cada valor separadamente; este arquivo de exemplo nao contem segredos.
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
PGPASSWORD=
DEMO_PASSWORD=

PGDATABASE=loja
PGUSER=loja
APP_PORT=8000
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
ENABLE_DEMO_DATA=true
